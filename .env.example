# 必填：阿里云百炼 DashScope API Key
DASHSCOPE_API_KEY=sk-your-dashscope-key

# 可选：服务接口鉴权。设置后，除 /health 外的请求需携带 X-API-Key
RKB_API_KEY=

# 可选：Streamlit 通过 API 访问知识库时设置，例如 http://localhost:8000
RKB_API_URL=

# 模型：默认只读取本地目录，不会联网下载
RKB_LLM_MODEL=qwen-turbo
RKB_EMBEDDING_MODEL=models/bge-small-zh-v1.5
RKB_DEVICE=cpu
RKB_ALLOW_MODEL_DOWNLOAD=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# RAG 参数
RKB_DATA_DIR=./data
RKB_CHUNK_SIZE=800
RKB_CHUNK_OVERLAP=150
RKB_RETRIEVER_K=5
RKB_CANDIDATE_K=20
RKB_RETRIEVAL_MODE=hybrid
RKB_RRF_K=60
RKB_RERANKER_ENABLED=false
RKB_RERANKER_MODEL=models/bge-reranker-base

# 服务设置
RKB_MAX_UPLOAD_MB=20
RKB_CORS_ORIGINS=http://localhost:8501
RKB_LOG_LEVEL=INFO
